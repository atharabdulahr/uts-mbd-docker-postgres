# === Salin file ini menjadi .env lalu isi sesuai data kamu ===
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)

# Identitas (huruf kecil, tanpa spasi) -> dipakai untuk nama kontainer
NAMA=abdoel
# Tiga digit terakhir NIM -> port 22XXX (PostgreSQL) dan 44XXX (pgAdmin)
NIM3=000

# PostgreSQL
POSTGRES_VERSION=15
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ifunggul
POSTGRES_DB=uts_mbd

# pgAdmin 4 (email harus format valid, domain special-use seperti .local ditolak)
PGADMIN_DEFAULT_EMAIL=admin@uinsgd.ac.id
PGADMIN_DEFAULT_PASSWORD=ifunggul

# Password untuk user aplikasi (dibuat oleh sql/02_users_roles.sql)
BACKEND_DEV_PASSWORD=backend_ifunggul
BI_DEV_PASSWORD=bi_ifunggul
DATA_ENGINEER_PASSWORD=de_ifunggul
